

generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  AGENT
  ADMIN
}

enum PropertyType {
  HOUSE
  LAND
  APARTMENT
  OFFICE
  SHOP
}

enum PropertyPurpose {
  RENT
  SELL
  LEASE
}

enum PropertyStatus {
  SOLD
  AVAILABLE
  PENDING
  RENTED
}

enum AppointmentStatus {
  PENDING
  CANCELLED
  CONFIRMED
  COMPLETED
}

enum LeadStatus {
  NEW
  QUALIFIED
  CONTACTED
  APPOINTMENT_BOOKED
  CLOSED
  LOST
}

enum AIAgentType {
  BUY
  SELL
  RENT
  RECEPTIONIST
}

enum InvitationStatus {
  PENDING
  CANCELLED
  EXPIRED
  ACCEPTED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  CANCELLED
  EXPIRED
}

model User {
  id                 String              @id @default(uuid())
  fullName           String
  password           String
  email              String              @unique
  role               Role                @default(AGENT)
  isVerified         Boolean             @default(false)
  otp                Otp[]
  company            Company?            @relation(fields: [companyId], references: [id])
  companyId          String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  leads              Lead[]
  appointsments      Appointment[]
  notifications      Notification[]
  uploads            Upload[]
  propertyAgents PropertyAgent[]
  invitionsSent      CompanyInvitation[] @relation("InvitationsSent")
  
}

model Otp {
  id        String   @id @default(uuid())
  email     String
  code      String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Company {
  id                 String              @id @default(uuid())
  name               String
  email              String              @unique
  phoneNumber        String
  address            String?
  website            String?
  logo               Upload              @relation(fields: [logoId], references: [id])
  logoId             String              @unique
  description        String
  users              User[]
  properties         Property[]
  customers          Customer[]
  AiAgents           AIAgent[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt()
  subscriptions      Subscription[]
  companyInvitations CompanyInvitation[]
}

model Property {
  id              String          @id @default(uuid())
  title           String
  description     String
  price           Int
  address         String
  state           String
  country         String
  propertyType    PropertyType    @default(APARTMENT)
  propertyPurpose PropertyPurpose @default(SELL)
  propertyStatus  PropertyStatus
  company         Company         @relation(fields: [companyId], references: [id])
  companyId       String
  bedrooms        Int?
  bathrooms       Int?
  parkingSpace    Int

  leads         Lead[]
  appointments  Appointment[]
  assignedAgents PropertyAgent[]
  attachment    Attachments   @relation(fields: [attachmentsId], references: [id])
  attachmentsId String        @unique
  createdAt     DateTime      @default(now())
}

model Upload {
  id       String @id @default(uuid())
  name     String
  type     String
  publicId String
  url      String

  order         Int
  user          User         @relation(fields: [userId], references: [id])
  userId        String
  company       Company?
  attachment    Attachments? @relation(fields: [attachmentsId], references: [id])
  attachmentsId String?
  createdAt     DateTime     @default(now())
}

model Attachments {
  id            String         @id @default(uuid())
  uploads       Upload[]
  properties    Property[]
  leads         Lead[]
  appointments  Appointment[]
  calls         Call[]
  conversations Conversation[]
  payments      Payment[]

  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id            String         @id @default(uuid())
  fullName      String
  email         String
  phone         String
  company       Company        @relation(fields: [companyId], references: [id])
  companyId     String
  leads         Lead[]
  appointments  Appointment[]
  calls         Call[]
  conversations Conversation[]
}

model Lead {
  id     String   @id @default(cuid())
  budget Decimal? @db.Decimal(12, 2)

  notes String?

  status LeadStatus @default(NEW)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id])

  assignedAgentId String?
  assignedAgent   User?   @relation(fields: [assignedAgentId], references: [id])

  appointments  Appointment[]
  attachment    Attachments   @relation(fields: [attachmentsId], references: [id])
  attachmentsId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanyInvitation {
  id          String           @id @default(uuid())
  email       String
  role        Role             @default(AGENT)
  token       String
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  company     Company          @relation(fields: [companyId], references: [id])
  companyId   String
  invitedById String
  invitedBy   User             @relation("InvitationsSent", fields: [invitedById], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  
}

model Appointment {
  id String @id @default(uuid())

  appointmentDate DateTime

  status AppointmentStatus @default(PENDING)

  notes String?

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  leadId        String?
  lead          Lead?        @relation(fields: [leadId], references: [id])
  attachment    Attachments? @relation(fields: [attachmentsId], references: [id])
  attachmentsId String?

  createdAt DateTime @default(now())
}

model PropertyAgent {
  id String @id @default(cuid())

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  agentId String
  agent   User @relation(fields: [agentId], references: [id], onDelete: Cascade)

  isPrimary Boolean @default(false)
  assignedAt DateTime @default(now())

  @@unique([propertyId, agentId])
  @@index([agentId])
}

model AIAgent {
  id String @id @default(cuid())

  name String

  type AIAgentType

  voiceId String?

  prompt String

  isActive Boolean @default(true)

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  conversations Conversation[]
  calls         Call[]

  createdAt DateTime @default(now())
}

model Call {
  id String @id @default(cuid())

  phone String

  duration Int?

  recordingUrl String?

  startedAt DateTime

  endedAt DateTime?

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  agentId       String
  agent         AIAgent     @relation(fields: [agentId], references: [id])
  attachment    Attachments @relation(fields: [attachmentsId], references: [id])
  attachmentsId String

  conversation Conversation?

  createdAt DateTime @default(now())
}

model Conversation {
  id String @id @default(cuid())

  transcript String

  summary String?

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  callId String @unique
  call   Call   @relation(fields: [callId], references: [id])

  agentId       String
  agent         AIAgent     @relation(fields: [agentId], references: [id])
  attachment    Attachments @relation(fields: [attachmentsId], references: [id])
  attachmentsId String

  createdAt DateTime @default(now())
}

model Plan {
  id String @id @default(cuid())

  name String

  price Decimal @db.Decimal(10, 2)

  maxAgents Int

  maxProperties Int

  maxCalls Int

  maxAiAgents Int

  subscriptions Subscription[]
}

model Subscription {
  id String @id @default(cuid())

  status SubscriptionStatus

  stripeCustomerId String

  stripeSubscriptionId String

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  payments Payment[]

  expiresAt DateTime

  createdAt DateTime @default(now())
}

model Payment {
  id String @id @default(cuid())

  amount Decimal @db.Decimal(10, 2)

  currency String

  status String

  stripePaymentIntent String

  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  attachment     Attachments  @relation(fields: [attachmentsId], references: [id])
  attachmentsId  String

  createdAt DateTime @default(now())
}

model Notification {
  id String @id @default(cuid())

  title String

  message String

  isRead Boolean @default(false)

  userId        String
  user          User        @relation(fields: [userId], references: [id])
  attachment    Attachments @relation(fields: [attachmentsId], references: [id])
  attachmentsId String

  createdAt DateTime @default(now())
}
