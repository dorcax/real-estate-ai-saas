model Property {
  id          String  @id @default(uuid())
  title       String
  description String
  price       Decimal @db.Decimal(18, 2)
  currency    String  @default("NGN")

  address    String
  city       String?
  state      String
  country    String
  postalCode String?
  latitude   Decimal? @db.Decimal(10, 7)
  longitude  Decimal? @db.Decimal(10, 7)

  propertyType    PropertyType    @default(APARTMENT)
  propertyPurpose PropertyPurpose @default(SELL)
  propertyStatus  PropertyStatus  @default(DRAFT)

  bedrooms     Int?
  bathrooms    Int?
  toilets      Int?
  parkingSpace Int?
  landSize     Float?
  buildingSize Float?
  yearBuilt    Int?
  amenities    String[]  @default([])
  isFeatured   Boolean   @default(false)
  publishedAt  DateTime?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("PropertyCreator", fields: [createdById], references: [id])

  attachmentsId String?      @unique
  attachment    Attachments? @relation("PropertyAttachments", fields: [attachmentsId], references: [id], onDelete: SetNull)

  leads          Lead[]
  appointments   Appointment[]
  assignedAgents PropertyAgent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, companyId])
  @@index([companyId])
  @@index([companyId, propertyStatus])
  @@index([companyId, propertyPurpose])
  @@index([companyId, propertyType])
  @@index([state, city])
  @@index([price])
  @@index([createdById])
}

model PropertyAgent {
  id String @id @default(cuid())

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  agentId String
  agent   User   @relation("AssignedPropertyAgent", fields: [agentId], references: [id], onDelete: Cascade)

  createdBy   User   @relation("CreatedBy", fields: [createdById], references: [id])
  createdById String

  isPrimary  Boolean   @default(false)
  assignedAt DateTime  @default(now())
  removedAt  DateTime?

  @@unique([propertyId, agentId])
  @@index([agentId])
  @@index([propertyId])
}
